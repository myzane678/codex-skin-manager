{
  "name": "codex-skin-manager",
  "productName": "Codex Skin Manager",
  "version": "0.1.0",
  "description": "Windows Codex welcome-page theme manager",
  "main": ".vite/build/main.js",
  "private": true,
  "type": "commonjs",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "semver": "7.8.5",
    "sharp": "^0.35.3",
    "ws": "8.21.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.10.13",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@types/ws": "8.18.1",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.1.1",
    "eslint": "10.7.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "yazl": "3.3.1"
